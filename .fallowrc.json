{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "clients/typescript/mod.ts",
    "src/main.ts"
  ],
  "rules": {
    "boundary-violation": "error"
  },
  "boundaries": {
    "zones": [
      {
        "name": "domain",
        "patterns": [
          "src/virtual_account.ts",
          "src/virtual_bot.ts",
          "src/virtual_chat.ts",
          "src/chat_membership.ts"
        ]
      },
      {
        "name": "account-repository",
        "patterns": [
          "src/repositories/account.ts"
        ]
      },
      {
        "name": "bot-repository",
        "patterns": [
          "src/repositories/bot.ts"
        ]
      },
      {
        "name": "chat-repository",
        "patterns": [
          "src/repositories/chat.ts"
        ]
      },
      {
        "name": "identity-repository",
        "patterns": [
          "src/repositories/telegram_identity.ts"
        ]
      },
      {
        "name": "services",
        "patterns": [
          "src/services/**/*.ts"
        ]
      },
      {
        "name": "composition",
        "patterns": [
          "src/repositories/session.ts"
        ]
      },
      {
        "name": "transport",
        "patterns": [
          "src/api/**/*.ts",
          "src/config.ts",
          "src/server.ts",
          "src/main.ts"
        ]
      }
    ],
    "rules": [
      {
        "from": "domain",
        "allow": []
      },
      {
        "from": "account-repository",
        "allow": [
          "domain"
        ]
      },
      {
        "from": "bot-repository",
        "allow": [
          "domain"
        ]
      },
      {
        "from": "chat-repository",
        "allow": [
          "domain"
        ]
      },
      {
        "from": "identity-repository",
        "allow": [
          "domain"
        ]
      },
      {
        "from": "services",
        "allow": [
          "domain"
        ],
        "allowTypeOnly": [
          "account-repository",
          "bot-repository",
          "chat-repository",
          "identity-repository"
        ]
      },
      {
        "from": "composition",
        "allow": [
          "domain",
          "account-repository",
          "bot-repository",
          "chat-repository",
          "identity-repository",
          "services"
        ]
      },
      {
        "from": "transport",
        "allow": [
          "domain",
          "composition",
          "transport"
        ]
      }
    ],
    "coverage": {
      "requireAllFiles": true,
      "allowUnmatched": [
        "tests/**",
        "clients/**"
      ]
    }
  }
}
