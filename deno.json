{
  "lock": false,
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-env=DOMAIN,PORT --allow-import=cdn.jsdelivr.net,cdn.skypack.dev,jsr.io src/main.ts",
    "start": "deno run --allow-net --allow-env=DOMAIN,PORT --allow-import=cdn.jsdelivr.net,cdn.skypack.dev,jsr.io src/main.ts",
    "fmt:check": "deno fmt --check",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "check": "deno check --allow-import=cdn.jsdelivr.net,cdn.skypack.dev,jsr.io src/ tests/",
    "test": "deno test --allow-net=127.0.0.1 --allow-import=cdn.jsdelivr.net,cdn.skypack.dev,jsr.io"
  },
  "imports": {
    "grammy/types": "https://cdn.jsdelivr.net/gh/grammyjs/grammY@^1.46.0/src/types.ts",
    "hono": "jsr:@hono/hono@^4.13.7",
    "hono/route": "jsr:@hono/hono@^4.13.7/route",
    "zod": "npm:zod@^4.6.5"
  },
  "fmt": {
    "options": {
      "lineWidth": 100,
      "indentWidth": 2,
      "singleQuote": true
    }
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "compilerOptions": {
    "strict": true
  }
}
